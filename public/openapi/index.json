[
  {
    "name": "example-store/example.yaml",
    "project": "example-store",
    "document": {
      "openapi": "3.0.3",
      "info": {
        "title": "Example Store API",
        "version": "1.0.0",
        "description": "A small example schema. Replace this file with your own OpenAPI schemas."
      },
      "tags": [
        {
          "name": "Products"
        }
      ],
      "paths": {
        "/products": {
          "get": {
            "operationId": "listProducts",
            "summary": "List products",
            "description": "Returns products available in the store.",
            "tags": [
              "Products"
            ],
            "parameters": [
              {
                "name": "limit",
                "in": "query",
                "description": "Maximum number of products to return.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            ],
            "responses": {
              "200": {
                "description": "Products in the requested page.",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "format": "int64"
                          },
                          "name": {
                            "type": "string"
                          },
                          "available": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "post": {
            "operationId": "createProduct",
            "summary": "Create a product",
            "tags": [
              "Products"
            ],
            "requestBody": {
              "required": true,
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Display name for the product."
                      },
                      "price": {
                        "type": "number",
                        "description": "Price in the store currency."
                      }
                    }
                  }
                }
              }
            },
            "responses": {
              "201": {
                "description": "The product was created."
              }
            }
          }
        }
      }
    }
  }
]
