{
  "name": "docgenerator",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "docs": "tsx scripts/generate-openapi-docs.ts",
    "dev": "pnpm run docs && vite",
    "build": "pnpm run docs && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-format": "^2.0.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.2",
    "vite": "^8.3.0"
  }
}
